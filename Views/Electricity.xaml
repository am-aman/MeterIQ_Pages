                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Compare by" Foreground="#7A848D" Margin="20 15 0 0"/>

                            <Grid Grid.Row="1" Margin="0 4 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="15" Background="#182B3D" Margin="20 0 5 0" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text=" Period " HorizontalAlignment="Center" FontSize="11" Foreground="#54A9FF" Padding="3 7 0 5"/>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="15" Background="#0e1c2a" Margin="0 0 5 0" Width="50" VerticalAlignment="Center" HorizontalAlignment="Left"  BorderBrush="#7A848D" BorderThickness="0.5">
                                    <TextBlock Text="Meter" HorizontalAlignment="Center" FontSize="11" Foreground="#7A848D" Padding="0 7 0 5"/>
                                </Border>
                                <Border Grid.Column="2" CornerRadius="15" Background="#0e1c2a" Margin="0 0 10 0" Width="80" VerticalAlignment="Center" HorizontalAlignment="Left"  BorderBrush="#7A848D" BorderThickness="0.5">
                                    <TextBlock Text="Normalized" HorizontalAlignment="Center" FontSize="11" Foreground="#7A848D" Padding="3 7 0 5"/>
                                </Border>
                                <Border Grid.Column="3" CornerRadius="15" Background="#0e1c2a" Margin="0 0 10 0" Width="135" VerticalAlignment="Center" HorizontalAlignment="Right"  BorderBrush="#7A848D" BorderThickness="0.5">
                                    <TextBlock Text="Expected Consumption" HorizontalAlignment="Center" FontSize="11" Foreground="#7A848D" Padding="0 7 0 5"/>
                                </Border>


                            </Grid>


                        </Grid>

                        <Grid Grid.Row="2" Margin="0 10 0 0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Metre" FontSize="13" FontWeight="Regular" Foreground="#7A848D" VerticalAlignment="Center" Margin="20 0 0 0"/>


                                    <ComboBox Style="{StaticResource DarkComboBox}" Width="170" Margin="20,23,0,0"
                                          HorizontalAlignment="Left" Grid.RowSpan="2">
                                        <ComboBoxItem Content="Vox Cinemas" IsSelected="True"/>
                                        <ComboBoxItem Content="Fun Zone"/>
                                        <ComboBoxItem Content="Food Court"/>
                                        <ComboBoxItem Content="Hypermarket GF"/>
                                    </ComboBox>

                                </Grid>
                            </Grid>

                            <Grid Grid.Column="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Compare" FontSize="13" FontWeight="Regular" Foreground="#7A848D" VerticalAlignment="Center" Margin="0,0,66,0"/>


                                    <ComboBox Style="{StaticResource DarkComboBox2}" Width="190" Margin="0,23,0,0"
                                          HorizontalAlignment="Left" Grid.RowSpan="2">
                                        <ComboBoxItem Content="This Month Vs Previous" IsSelected="True"/>
                                        <ComboBoxItem Content="Last Month Vs This Month" />
                                        <ComboBoxItem Content="Last Quarter Vs This Quater"/>
                                        <ComboBoxItem Content="Last Year Vs This Year" />
                                    </ComboBox>

                                </Grid>
                            </Grid>


                        </Grid>
                        <Grid Grid.Row="3">


                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"></ColumnDefinition>                                
                                <ColumnDefinition  Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="20" Margin="31,10,22,10">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Assets/Images/canbonpercentage.png"/>
                                </Border.Background>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                        <RowDefinition></RowDefinition>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Consumption&#10;Reduction" Foreground="#D4E7FA" FontSize="10" Margin="10 10 0 0" />

                                    <TextBlock Grid.Row="1" Text="-7.4%" FontSize="35" FontWeight="SemiBold" Foreground="#7CB683" Margin="10 0 0 0"/>

                                    <TextBlock Grid.Row ="2" Text="7.42 MWh current week&#10;8.01 MWh previous week&#10;Difference: −0.59 MWh" Foreground="#B7C9DC" Margin="10 5 0 0" LineHeight="10" FontSize="8"/>


                                </Grid>
                            </Border>

                            <Grid Grid.Column="1" Margin="-10 30 30 30">

                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Previous Week" FontSize="9" Foreground="#7A848D" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <TextBlock Grid.Column="1" Text="8.01 MWh" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="9" Foreground="White"/>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Border Background="#0d1b29" CornerRadius="5" Height="8" Margin="0 0 0 0">
                                        <Border Background="#579ADC" Width="199" HorizontalAlignment="Left" CornerRadius="5" Height="8" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Current Week" FontSize="9" Foreground="#7A848D" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <TextBlock Grid.Column="1" Text="7.41 MWh" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="9" Foreground="White"/>
                                </Grid>

                                <Grid Grid.Row="3">
                                    <Border Background="#0d1b29" CornerRadius="5" Height="8" Margin="0 0 0 0">
                                        <Border Background="#7CB683" Width="150" HorizontalAlignment="Left" CornerRadius="5" Height="8" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition></ColumnDefinition>
                                        <ColumnDefinition></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Current Demand" FontSize="9" Foreground="#7A848D" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <TextBlock Grid.Column="1" Text="-4.01" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="9" Foreground="White"/>
                                </Grid>

                                <Grid Grid.Row="5">
                                    <Border Background="#0d1b29" CornerRadius="5" Height="8" Margin="0 0 0 0">
                                        <Border Background="#9EB7CF" Width="150" HorizontalAlignment="Left" CornerRadius="5" Height="8" />
                                    </Border>
                                </Grid>


                            </Grid>


                        </Grid>

                    </Grid>

                   

                </Border>


            </Grid>
        </Grid>

    </Grid>
</UserControl>
