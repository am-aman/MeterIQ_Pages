<Window x:Class="ElectricityMeterIQ1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectricityMeterIQ1"
        mc:Ignorable="d"
        xmlns:views="clr-namespace:ElectricityMeterIQ1.Views"
        Title="MainWindow" Height="600" Width="1280" MinHeight="600" MinWidth="1280"> 
    
    <!--the window size of the actual project is 1320x720 , but i have used 1280x600 for the Lenovo T14 developement-->
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Images/background.png" Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Top"/>
        </Grid.Background>
        <!--this is the main grid , row one for header (logo , nav bar) , row 2 for content-->
        <Viewbox Stretch="Fill"
         StretchDirection="Both"
         HorizontalAlignment="Center"
         VerticalAlignment="Top">
            
            <Grid Width="1540" Height="815">
                <Grid.RowDefinitions>
                    <RowDefinition Height="75"></RowDefinition>
                    <RowDefinition Height="740"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="Transparent">
                    <TextBlock Text="Header is visible once the view is connected to the project !" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="UltraBlack"/>
                </Border>
                <!--end of the header-->
                
                
                <Grid Grid.Row="1" Background="Transparent">
                    <Frame x:Name="MainFrame"
                           NavigationUIVisibility="Hidden"
                           Background="Transparent"></Frame>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
